<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><style>[hidden]{display:none!important}body{margin:0}</style><link rel="icon" href="https://manassa-study.github.io/Tafseer/favicon.png" type="image/png" sizes="48x48"><link rel="icon" href="https://manassa-study.github.io/Tafseer/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="https://manassa-study.github.io/Tafseer/apple-touch-icon.png"><title>{{ book.title }} — {{ site.platform_name }}</title><meta name="description" content="{{ book.description }}"><meta name="theme-color" content="{{ book.theme.browser_theme_color }}"><meta property="og:title" content="{{ book.title }} — {{ site.platform_name }}"><meta property="og:description" content="{{ book.description }}"><meta property="og:type" content="website"><meta property="og:site_name" content="{{ site.platform_name }}"><meta property="og:url" content="{{ (site.base_url ~ book.output)|url }}"><meta property="og:image" content="{{ (site.base_url ~ book.og_image)|url }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:locale" content="ar_AR"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="{{ (site.base_url ~ book.og_image)|url }}"></head><body>
<meta name="claude:viewport-fit-sides" content="cover">
<script>document.documentElement.setAttribute("dir","rtl");document.documentElement.setAttribute("lang","ar");try{var _t=JSON.parse(localStorage.getItem("{{ book.storage_key }}")||"{}").theme;}catch(e){}document.documentElement.setAttribute("data-theme",_t==="dark"?"dark":"light");</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ site.fonts_url|url }}">
