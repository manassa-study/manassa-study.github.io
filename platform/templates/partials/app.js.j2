function blockHTML(b,i){
  let h=`<details class="blk${b.exam?" exam":""}" id="b${i}"${i===0?" open":""}><summary><h3>${rich(b.cleanLabel)}${b.exam?` <span class="tag exam">موضع سؤال امتحاني</span>`:""}</h3></summary><div class="blk-b">`;
  if(b.text)h+=`<p>${rich(b.text)}</p>`;
  if(b.ayah){const m=b.ayah.match(/^(﴿[^﴾]*﴾)\s*(.*)$/);h+=`<div class="ayah-box"><span class="ayah">${esc(m?m[1]:b.ayah)}</span>${m&&m[2]?`<span class="ref">${esc(m[2])}</span>`:""}</div>`;}
  if(b.list)h+=list(b.list);
  return h+`</div></details>`;
}
function questionBlock(q,i,prefix){
  return `<div class="qcard" data-q="${q.id}" data-prefix="${prefix}">
    <div class="row"><span class="tag">${esc(q.type)}</span></div>
    <div class="qtext">${rich(q.q)}</div>
    <div class="opts">${q.options.map((o,oi)=>`<button class="opt" data-oi="${oi}"><span class="l">${"أبجد"[oi]}</span><span>${rich(o)}</span></button>`).join("")}</div>
    <div class="fb"></div></div>`;
}
function wirePractice(root){
  root.querySelectorAll(".qcard").forEach(card=>{
    const q=QB.find(x=>x.id==card.dataset.q);
    card.querySelectorAll(".opt").forEach(btn=>btn.onclick=()=>{
      const oi=+btn.dataset.oi,ok=oi===q.correct;
      card.querySelectorAll(".opt").forEach((b,bi)=>{b.disabled=true;if(bi===q.correct)b.classList.add("right");});
      if(!ok)btn.classList.add("wrong");
      card.querySelector(".fb").innerHTML=`<div class="exp ${ok?"ok":"no"}"><b>${ok?"إجابة صحيحة. ":"الإجابة الصحيحة: "+"أبجد"[q.correct]+". "}</b>${rich(q.exp)}</div>`;
    });
  });
}

function viewStudy(id){
  const t=byId[id]||TOPICS[0];S.last=t.id;save();
  const prev=TOPICS[t.idx-1],next=TOPICS[t.idx+1];
  const examCount=t.blocks.filter(b=>b.exam).length;
  V.innerHTML=`<article class="stack-lg">
   <header class="topic-h">
     <div class="crumb"><a href="#home">الرئيسية</a>›<span>${esc(t.ch.title.split(":")[0])}</span>›<span>${esc(t.sec.title.split(":")[0])}</span></div>
     <div class="topic-k">${esc(t.k||"")} <span class="pg">${esc(t.pages)}</span></div>
     <h1 class="h1">${esc(t.short)}</h1>
     <p class="lead">${esc(t.sec.title)}${t.sec.tag?` · ${esc(t.sec.tag)}`:""}</p>
     <div class="toolrow">
       <div class="row">
         <span class="tag">${toAr(t.blocks.length)} فقرات</span>
         ${examCount?`<span class="tag exam">${toAr(examCount)} موضع امتحاني</span>`:""}
         ${t.fc.length?`<span class="tag acc">${toAr(t.fc.length)} بطاقة</span>`:""}
         ${t.qs.length?`<span class="tag gold">${toAr(t.qs.length)} سؤال</span>`:""}
       </div>
       <div class="row">${t.blocks.length>1?`<button class="btn ghost" id="blkAll">افتح كل الفقرات</button>`:""}${t.fc.length||t.qs.length?`<a class="btn ghost" href="#study-${t.id}" id="jumpTest">انتقل إلى «اختبر نفسك» ↓</a>`:""}</div>
     </div>
   </header>
   ${t.sum?`<details class="tsum"><summary><b>الخلاصة في ثلاثة أسطر</b><span>عرض</span></summary><ol>${t.sum.map(x=>`<li>${rich(x)}</li>`).join("")}</ol></details>`:""}<div class="reading">${t.blocks.map(blockHTML).join("")}</div>
   ${t.ex.length?`<section class="stack"><h2 class="h2">{% if "S2-3" in step2 %}${BOOK.labels.examples_in_lesson}{% else %}{{ book.labels.examples_in_lesson }}{% endif %}</h2><div class="ex-grid">${t.ex.map(exCard).join("")}</div></section>`:""}
   ${t.fc.length||t.qs.length?`<details class="selftest" id="selftest"><summary><h2 class="h2" style="font-size:17px">اختبر نفسك في هذا المطلب</h2><span class="tag">${[t.fc.length?toAr(t.fc.length)+" بطاقة":"",t.qs.length?toAr(t.qs.length)+" سؤال":""].filter(Boolean).join(" · ")}</span><em>افتح ▾</em></summary>
     <div>
      ${t.fc.map(c=>`<div class="mini-fc"><button class="q">${rich(c.q)}</button><div class="a">${rich(c.a)}</div></div>`).join("")}
      ${t.qs.map((q,i)=>questionBlock(q,i,"st")).join('<hr style="border:0;border-top:1px dashed var(--line);margin:0;width:100%">')}
     </div></details>`:""}
   <div class="done-bar${S.done[t.id]?" is-done":""}">
     <div><b>${S.done[t.id]?"تمت دراسة هذا المطلب":"أنهيت القراءة؟"}</b><div style="font-size:13px;color:var(--muted)">${S.done[t.id]?"يظهر بعلامة ✓ في الفهرس.":"علّمه ليظهر تقدمك في الفهرس."}</div></div>
     <button class="btn ${S.done[t.id]?"":"primary"}" id="doneBtn">${S.done[t.id]?"إلغاء العلامة":"تمت دراسته ✓"}</button>
   </div>
   <nav class="pager">
     ${prev?`<a href="#study-${prev.id}"><small>→ السابق</small><span>${esc(prev.short)}</span></a>`:"<span></span>"}
     ${next?`<a class="nx" href="#study-${next.id}"><small>التالي ←</small><span>${esc(next.short)}</span></a>`:`<a class="nx" href="#quiz"><small>انتهى المقرر ←</small><span>ادخل الاختبار المحاكي</span></a>`}
   </nav>
  </article>`;
  $("#doneBtn").onclick=()=>{S.done[t.id]=!S.done[t.id];save();const y=scrollY;route();scrollTo(0,y);};
  const ba=$("#blkAll");if(ba)ba.onclick=()=>{const ds=[...V.querySelectorAll("details.blk")],o=!ds.every(d=>d.open);ds.forEach(d=>d.open=o);ba.textContent=o?"اطوِ كل الفقرات":"افتح كل الفقرات";};
  const j=$("#jumpTest");if(j)j.onclick=e=>{e.preventDefault();$("#selftest").open=true;$("#selftest").scrollIntoView({behavior:"smooth",block:"start"});};
  V.querySelectorAll(".mini-fc .q").forEach(b=>b.onclick=()=>b.parentElement.classList.toggle("open"));
  wirePractice(V);
  return t.id;
}

function exCard(e){
  return `<article class="card ex"><div class="row" style="justify-content:space-between"><span class="tag gold">${esc(e.surah)}</span><span class="tag">${esc(e.category)}</span></div>
    <div class="ayah{% if features.example_ayah_plain %}{% else %}${e.ayah.startsWith("﴿")?"":" hd"}{% endif %}">${esc(e.ayah)}</div><p class="d">${rich(e.detail)}</p></article>`;
}

/* review */
let fcState={cat:"الكل",onlyNew:false,i:0,flip:false,order:null};
function viewReview(tab){
  tab=["cards","tables","capsules","ayat","sheet"].includes(tab)?tab:"cards";S.reviewTab=tab;save();
  const tabs=[["cards","البطاقات"],["tables","الفروق"],["capsules","للحفظ"],{% if "S2-3" in step2 %}["ayat",BOOK.labels.examples_short]{% else %}["ayat","{{ book.labels.examples_short }}"]{% endif %},["sheet","الملزمة"]];
  V.innerHTML=`<div class="stack-lg"><header class="phead"><div class="eyebrow">مراجعة ليلة الاختبار</div><h1 class="h1">المراجعة السريعة</h1>
   <p class="lead">{{ book.labels.review_subtitle }}، كلها بأرقام صفحات الكتاب.</p></header>
   <div class="seg" role="tablist">${tabs.map(([k,l])=>`<button role="tab" aria-selected="${k===tab}" data-t="${k}">${l}</button>`).join("")}</div>
   <div id="rv"></div></div>`;
  V.querySelectorAll(".seg button").forEach(b=>b.onclick=()=>{location.hash="review-"+b.dataset.t;});
  const R=$("#rv");
  if(tab==="cards")renderCards(R);
  if(tab==="tables")R.innerHTML=`<div class="stack">${TB.map(tb=>`<section class="cmp"><h3>${rich(tb.title)}</h3><div style="overflow-x:auto"><table><thead><tr>${tb.headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead><tbody>${tb.rows.map(r=>`<tr>${r.map((c,i)=>`<td data-h="${esc(tb.headers[i])}">${rich(c)}</td>`).join("")}</tr>`).join("")}</tbody></table></div></section>`).join("")}</div>`;
  if(tab==="capsules")R.innerHTML=`<div class="caps">${CAPS.map(g=>`<section class="card"><h3>${esc(g.title)}</h3><ul>${g.items.map(it=>`<li><b>${rich(it.k)}</b> ${rich(it.v)}</li>`).join("")}</ul></section>`).join("")}</div>`;
  if(tab==="sheet"){R.innerHTML=`<div class="sheet"><div class="sheet-bar no-print"><p>كل المطالب في صفحات قليلة: خلاصة كل مطلب في ثلاثة أسطر، ثم كبسولات الحفظ. اطبعها أو احفظها PDF.</p><button class="btn primary" id="shPrint">اطبع الملزمة</button></div>
    <header class="sheet-h"><b>ملزمة مراجعة «{{ book.title }}»</b><span>${toAr(TOPICS.length)} مطلباً · ص ١ - ${toAr(Math.max(...TOPICS.map(t=>t.to)))}</span></header>
    ${CH.map(c=>`<section class="sh-ch"><h2>${esc(c.title)}</h2>${c.sections.map(s=>`<div class="sh-sec"><h3>${esc(s.title)}</h3>${s.topics.map(t=>`<div class="sh-t"><a href="#study-${t.id}"><b>${esc(t.short||t.title)}</b> <small>${esc(t.pages)}</small></a>${t.sum?`<ol>${t.sum.map(x=>`<li>${rich(x)}</li>`).join("")}</ol>`:""}</div>`).join("")}</div>`).join("")}</section>`).join("")}
    <section class="sh-ch"><h2>كبسولات الحفظ</h2><div class="sh-caps">${CAPS.map(g=>`<div class="sh-sec"><h3>${esc(g.title)}</h3><ul>${g.items.map(it=>`<li><b>${rich(it.k)}</b> ${rich(it.v)}</li>`).join("")}</ul></div>`).join("")}</div></section></div>`;
    $("#shPrint").onclick=()=>window.print();}
  if(tab==="ayat"){
    const cats=["الكل",...new Set(EX.map(e=>e.category))];let cur=S.exCat&&cats.includes(S.exCat)?S.exCat:"الكل";
    const draw=()=>{R.innerHTML=`<div class="stack"><div class="row">${cats.map(c=>`<button class="chip" aria-pressed="${c===cur}" data-c="${esc(c)}">${esc(c)}${c==="الكل"?` (${toAr(EX.length)})`:""}</button>`).join("")}</div>
      <div class="ex-grid">${EX.filter(e=>cur==="الكل"||e.category===cur).map(exCard).join("")}</div></div>`;
      R.querySelectorAll(".chip").forEach(b=>b.onclick=()=>{cur=b.dataset.c;S.exCat=cur;save();draw();});};
    draw();
  }
}
function fcList(){
  let l=FC.filter(c=>fcState.cat==="الكل"||c.cat===fcState.cat);
  if(fcState.onlyNew)l=l.filter(c=>!S.mastered[c.id]);
  if(fcState.order)l=fcState.order.map(id=>l.find(c=>c.id===id)).filter(Boolean);
  return l;
}
function renderCards(R){
  const cats=["الكل",...new Set(FC.map(c=>c.cat))];
  const l=fcList();if(fcState.i>=l.length)fcState.i=0;const c=l[fcState.i];
  const m=FC.filter(x=>S.mastered[x.id]).length;
  R.innerHTML=`<div class="fc-wrap">
   <details class="fc-filt" id="fcFilt"${fcState.filt?" open":""}><summary><span>تصفية البطاقات</span><em>${esc(fcState.cat)}${fcState.onlyNew?" · غير المتقنة":""}${fcState.order?" · عشوائي":""}</em><i>▾</i></summary>
   <div class="row" style="justify-content:space-between;margin-top:12px">
     <div class="row">${cats.map(k=>`<button class="chip" aria-pressed="${k===fcState.cat}" data-c="${esc(k)}">${esc(k)}</button>`).join("")}</div>
     <div class="row"><button class="chip" id="fcNew" aria-pressed="${fcState.onlyNew}">غير المتقنة فقط</button><button class="chip" id="fcShuf" aria-pressed="${!!fcState.order}">ترتيب عشوائي</button></div>
   </div></details>
   <div class="row" style="justify-content:space-between;font-size:13px;color:var(--muted)"><span>أتقنت ${toAr(m)} من ${toAr(FC.length)}</span><div class="bar" style="flex:1;max-width:260px"><i style="width:${m/FC.length*100}%;background:var(--ok)"></i></div></div>
   ${c?`<div class="fc${fcState.flip?" back":""}" id="fcBox" role="button" tabindex="0" aria-label="اقلب البطاقة">
     <div class="fc-top"><span>${esc(c.cat)}</span><span>${toAr(fcState.i+1)} / ${toAr(l.length)}</span></div>
     <div class="fc-body">${fcState.flip?`<div class="fc-a">${rich(c.a)}</div>`:`<div class="fc-q">${rich(c.q)}</div>`}</div>
     <div class="fc-hint">${fcState.flip?"اضغط للعودة إلى السؤال":"حاول الإجابة بصوت مسموع، ثم اضغط لكشف الجواب"}</div>
   </div>
   <div class="fc-ctrl">
     <button class="btn" id="fcPrev" aria-label="السابقة">→</button>
     <button class="btn again" id="fcAgain">أحتاج مراجعة</button>
     <button class="btn know" id="fcKnow">${S.mastered[c.id]?"✓ متقنة":"أتقنتها"}</button>
     <button class="btn" id="fcNext" aria-label="التالية">←</button>
   </div>
`
   :`<div class="card" style="text-align:center">أتقنت كل البطاقات في هذا التصنيف. <button class="btn ghost" id="fcAll">اعرض الكل</button></div>`}
  </div>`;
  const re=()=>renderCards(R);
  const ff=$("#fcFilt");if(ff)ff.ontoggle=()=>{fcState.filt=ff.open;};
  R.querySelectorAll(".chip[data-c]").forEach(b=>b.onclick=()=>{fcState.cat=b.dataset.c;fcState.i=0;fcState.flip=false;re();});
  $("#fcNew").onclick=()=>{fcState.onlyNew=!fcState.onlyNew;fcState.i=0;fcState.flip=false;re();};
  $("#fcShuf").onclick=()=>{fcState.order=fcState.order?null:shuffle(FC.map(x=>x.id));fcState.i=0;fcState.flip=false;re();};
  const all=$("#fcAll");if(all)all.onclick=()=>{fcState.onlyNew=false;re();};
  if(!c)return;
  const go=d=>{fcState.i=(fcState.i+d+l.length)%l.length;fcState.flip=false;re();};
  $("#fcBox").onclick=()=>{fcState.flip=!fcState.flip;re();};
  $("#fcBox").onkeydown=e=>{if(e.key===" "||e.key==="Enter"){e.preventDefault();fcState.flip=!fcState.flip;re();$("#fcBox").focus();}};
  $("#fcPrev").onclick=()=>go(-1);$("#fcNext").onclick=()=>go(1);
  $("#fcKnow").onclick=()=>{S.mastered[c.id]=true;delete S.again[c.id];save();if(fcState.onlyNew){fcState.flip=false;re();}else go(1);};
  $("#fcAgain").onclick=()=>{S.mastered[c.id]=false;S.again[c.id]=true;save();go(1);};
}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

/* mind maps (revision maps: tree / timeline / chains, with a self-test mode) */
const ORD=["الأول","الثاني","الثالث","الرابع","الخامس","السادس","السابع","الثامن","التاسع","العاشر","الحادي عشر","الثاني عشر","الثالث عشر","الرابع عشر","الخامس عشر"];
function bookMap(){
  return {id:"book",type:"index",group:"مراجعة شاملة",title:"فهرس الكتاب المرئي",sub:"{{ book.structure_summary }}"+toAr(TOPICS.length)+" مطلباً، اضغط أي مطلب لفتحه",
    branches:CH.flatMap(c=>c.sections.map(s=>({t:s.title,tag:s.tag||"",ch:c.title.split(":")[0],links:s.topics})))};
}
function mmTopicLink(p){if(!p)return "";const n=pagesOf(p)[0];const t=n&&topicByPage(n);return t?`<a class="mm-go" href="#study-${t.id}" title="افتح المطلب">${esc(p)} ←</a>`:`<span class="pg">${esc(p)}</span>`;}
function mmText(t){const i=t.indexOf(":");if(i>0&&i<70)return `<b class="k">${rich(t.slice(0,i+1))}</b> <span class="v">${rich(t.slice(i+1).trim())}</span>`;return `<span class="w">${rich(t)}</span>`;}
function mmNode(nd,depth){
  if(typeof nd==="string")return `<li class="lf${nd.indexOf(":")>0&&nd.indexOf(":")<70?" kv":""}"><div class="row1">${mmText(nd)}</div></li>`;
  const kids=nd.c||[];
  return `<li class="nd${kids.length?" hasc":""}"><button class="row1" type="button"${kids.length?"":" disabled"}>${mmText(nd.t)}${nd.n?`<span class="cnt">${esc(nd.n)}</span>`:""}${kids.length?`<span class="car" aria-hidden="true"></span>`:""}</button>${nd.p?mmTopicLink(nd.p):""}
    ${kids.length?`<ul>${kids.map(k=>mmNode(k,depth+1)).join("")}</ul>`:""}</li>`;
}
function mmTree(m){
  return `<div class="mt-grid">${m.branches.map((b,i)=>{const kids=b.c||[];return `<section class="mt-card" style="--c:var(--b${i%4+1})">
    <header class="mt-h"><span class="mt-i">${toAr(i+1)}</span><button class="mt-t" type="button">${rich(b.t)}${b.n?`<span class="cnt">${esc(b.n)}</span>`:""}</button>${mmTopicLink(b.p)}</header>
    <ul class="mt">${kids.map(k=>mmNode(k,1)).join("")}</ul></section>`;}).join("")}</div>`;
}
function mmTimeline(m){
  const cat=Object.fromEntries(m.cats.map(c=>[c.k,c.t]));
  return `<div class="tl-filter" role="group" aria-label="تلوين حسب اللون التفسيري"><span class="tl-fl">اعرض لوناً:</span><button class="tl-f" aria-pressed="true" data-k="">الكل</button>${m.cats.map(c=>`<button class="tl-f" aria-pressed="false" data-k="${c.k}" style="--k:var(--k-${c.k})"><i></i>${esc(c.t)}</button>`).join("")}</div>
  <ol class="tl">${m.items.map(it=>`<li class="tl-it" data-ks="${[...new Set(it.books.map(b=>b.k))].join(" ")}">
    <span class="tl-dot">${esc(it.c)}</span>
    <div class="tl-card"><header class="tl-h"><b>القرن ${ORD[+toEn(it.c)-1]}</b><span class="tl-tag">${esc(it.tag)}</span>${mmTopicLink(it.p)}</header>
      <div class="tl-body"><p class="tl-new"><span>المستحدث</span>${rich(it.new)}</p><p class="tl-sum">${rich(it.sum)}</p>
      <div class="tl-bks">${it.books.map(b=>`<span class="bk" data-k="${b.k}" style="--k:var(--k-${b.k})" title="${esc(cat[b.k]||"")}"><b>${esc(b.t)}</b><small>${esc(b.a)}${b.d?" · ت "+esc(b.d):""}</small></span>`).join("")}</div></div>
      <button class="tl-reveal" type="button">اضغط لكشف المستحدث والكتب</button>
    </div></li>`).join("")}</ol>`;
}
function mmChains(m){
  return `<div class="ch-grid">${m.chains.map(c=>`<section class="ch-card" style="--k:var(--k-${c.k})"><h3 class="ch-t">${esc(c.t)}</h3>
    <ol class="ch">${c.steps.map(s=>`<li class="ch-s"><span class="ch-c">ق${esc(s.c)}</span><button class="ch-b" type="button"><b class="ch-n">${rich(s.t)}</b><small>${rich(s.s)}</small></button></li>`).join("")}</ol></section>`).join("")}</div>`;
}
function mmIndex(m){
  return `<div class="mt-grid">${m.branches.map((b,i)=>`<section class="mt-card" style="--c:var(--b${i%4+1})"><header class="mt-h"><span class="mt-i">${toAr(i+1)}</span><div class="mt-t static">${rich(b.t)}<small>${esc(b.ch)}${b.tag?" · "+esc(b.tag):""}</small></div></header>
    <ul class="mt idx">${b.links.map(t=>`<li class="lf"><a class="row1" href="#study-${t.id}"><span class="w">${esc(t.short)}</span><span class="pg">${esc(t.pages)}</span>${S.done[t.id]?`<span class="ok">✓</span>`:""}</a></li>`).join("")}</ul></section>`).join("")}</div>`;
}
function viewMaps(idx){
  const maps=[...MM,bookMap()];idx=Math.min(Math.max(+idx||0,0),maps.length-1);S.mapIdx=idx;save();
  const m=maps[idx];const recall=!!S.mmRecall&&m.type!=="index";
  const groups=[...new Set(maps.map(x=>x.group))];
  const tip={tree:"كلمات مفتاحية مختصرة؛ الرقم الذهبي هو عدد العناصر المطلوب حفظها.",timeline:"اختر لوناً لترى أين ظهر وكيف امتد عبر القرون.",chains:"كل سلسلة تُقرأ من الأقدم إلى الأحدث، والرقم هو القرن.",index:"فهرس سريع لكل المطالب."}[m.type];
  V.innerHTML=`<div class="stack-lg"><header class="phead"><div class="eyebrow">خرائط المراجعة السريعة</div><h1 class="h1">${esc(m.title)}</h1><p class="lead">${rich(m.sub)}</p></header>
   <details class="mm2-dd" id="mmDD"${S.mmPick?" open":""}><summary><b class="no">${toAr(idx+1)}</b><span>${esc(m.title)}</span><em>تغيير الخريطة (${toAr(maps.length)}) ▾</em></summary>
   <nav class="mm2-pick" aria-label="اختر خريطة">${groups.map(g=>`<div class="mm2-g"><span>${esc(g)}</span><div>${maps.map((x,i)=>x.group!==g?"":`<button aria-pressed="${i===idx}" data-i="${i}"><b class="no">${toAr(i+1)}</b><span>${esc(x.title)}</span><i class="ty ty-${x.type}"></i></button>`).join("")}</div></div>`).join("")}</nav></details>
   <div class="mm2-bar"><p>${tip}</p>${m.type!=="index"?`<div class="row"><button class="btn ${recall?"primary":"ghost"}" id="mmRecall" aria-pressed="${recall}">${recall?"وضع التسميع مُفعّل":"وضع التسميع"}</button>${recall?`<button class="btn ghost" id="mmShow">اكشف الكل</button>`:""}</div>`:""}</div>
   ${recall?`<p class="mm2-hint">حاول أن تتذكر قبل الضغط: ${m.type==="tree"?"افتح كل فرع بعد أن تعدّ عناصره من ذاكرتك، واضغط على الكلمة المخفية لكشفها.":m.type==="timeline"?"تذكّر ما استحدثه القرن وأهم كتبه، ثم اضغط البطاقة.":"تذكّر صاحب كل حلقة من وصفها، ثم اضغط لكشفه."}</p>`:""}
   <div class="mm2 mm2-${m.type}${recall?" recall":""}" id="mm2">${m.type==="tree"?mmTree(m):m.type==="timeline"?mmTimeline(m):m.type==="chains"?mmChains(m):mmIndex(m)}</div>
   <div class="row" style="justify-content:space-between">${idx>0?`<a class="btn ghost" href="#maps-${idx-1}">→ ${esc(maps[idx-1].title)}</a>`:"<span></span>"}${idx<maps.length-1?`<a class="btn" href="#maps-${idx+1}">${esc(maps[idx+1].title)} ←</a>`:""}</div></div>`;
  V.querySelectorAll(".mm2-pick button").forEach(b=>b.onclick=()=>{S.mmPick=false;save();location.hash="maps-"+b.dataset.i;});
  const dd=$("#mmDD");if(dd)dd.ontoggle=()=>{S.mmPick=dd.open;save();};
  const R=$("#mmRecall");if(R)R.onclick=()=>{S.mmRecall=!S.mmRecall;save();viewMaps(idx);};
  const box=$("#mm2");
  const sh=$("#mmShow");if(sh)sh.onclick=()=>{box.querySelectorAll(".nd.hasc,.mt-card").forEach(n=>n.classList.add("open"));box.querySelectorAll(".lf,.tl-it,.ch-s").forEach(n=>n.classList.add("shown"));};
  /* tree: tap a node to fold/unfold; in recall mode tap a hidden value to reveal */
  box.querySelectorAll(".nd.hasc>.row1").forEach(b=>b.onclick=()=>{const p=b.parentElement,c=recall?"open":"closed";p.classList.toggle(c);b.setAttribute("aria-expanded",p.classList.contains("open")||(!recall&&!p.classList.contains("closed")));});
  box.querySelectorAll(".mt-t:not(.static)").forEach(b=>b.onclick=()=>b.closest(".mt-card").classList.toggle("open"));
  box.querySelectorAll(".lf.kv").forEach(l=>l.onclick=()=>l.classList.toggle("shown"));
  /* timeline */
  box.querySelectorAll(".tl-reveal").forEach(b=>b.onclick=()=>b.closest(".tl-it").classList.add("shown"));
  box.querySelectorAll(".tl-it").forEach(it=>it.querySelector(".tl-body").onclick=()=>it.classList.add("shown"));
  box.querySelectorAll(".tl-f").forEach(f=>f.onclick=()=>{const k=f.dataset.k;box.querySelectorAll(".tl-f").forEach(x=>x.setAttribute("aria-pressed",x===f));
    box.classList.toggle("filtered",!!k);box.querySelectorAll(".bk").forEach(b=>b.classList.toggle("hit",!!k&&b.dataset.k===k));
    box.querySelectorAll(".tl-it").forEach(it=>it.classList.toggle("hit",!!k&&it.dataset.ks.split(" ").includes(k)));});
  /* chains */
  box.querySelectorAll(".ch-b").forEach(b=>b.onclick=()=>b.parentElement.classList.toggle("shown"));
}

/* quiz */
const QZ={phase:"setup",mode:"practice",ch:"الكل",type:"الكل",shuffle:true,wrongOnly:false,bank:false,sec:"",cnt:20,qs:[],ans:{},i:0,deadline:0,timer:null};
