const FORM_URL="https://forms.gle/tjZzHuUUgH9fypX6A";
(function gate(){
  if(!/^https:\/\//.test(FORM_URL)||S.registered){showWelcome();return;}
  const g=$("#gate"),f=$("#gateForm"),b=$("#gateIn");
  f.href=FORM_URL;g.hidden=false;if(location.hash&&location.hash!=="#home")history.replaceState(null,"","#home");document.body.style.overflow="hidden";
