  const fi=$("#qFinish");if(fi)fi.onclick=finishQuiz;
  $("#qQuit").onclick=finishQuiz;
  if(!practice){clearInterval(QZ.timer);QZ.timer=setInterval(()=>{const el=$("#tmr");const left=QZ.deadline-Date.now();if(!el){clearInterval(QZ.timer);return;}el.textContent=fmt(left);el.classList.toggle("low",left<60000);if(left<=0)finishQuiz();},1000);}
}
function finishQuiz(){
  clearInterval(QZ.timer);
  const c=QZ.qs.filter(q=>QZ.ans[q.id]===q.correct).length;
  S.quizHist.push({mode:QZ.mode,ch:QZ.ch,c,n:QZ.qs.length,t:Date.now()});S.quizHist=S.quizHist.slice(-20);
  S.lastWrong=QZ.qs.filter(q=>QZ.ans[q.id]!==q.correct).map(q=>q.id);
  {const wb=new Set(S.wrongBank||[]);QZ.qs.forEach(q=>{if(QZ.ans[q.id]===q.correct)wb.delete(q.id);else if(QZ.ans[q.id]!==undefined)wb.add(q.id);});S.wrongBank=[...wb];}save();
  QZ.phase="done";QZ.reviewWrong=false;viewQuiz();scrollTo(0,0);
}
function quizDone(){
  const qs=QZ.qs,c=qs.filter(q=>QZ.ans[q.id]===q.correct).length,pct=Math.round(c/qs.length*100);
  const chs=[...new Set(QB.map(q=>q.chapter))].map(ch=>{const l=qs.filter(q=>q.chapter===ch);return {ch,n:l.length,c:l.filter(q=>QZ.ans[q.id]===q.correct).length};}).filter(x=>x.n);
  const list=QZ.reviewWrong?qs.filter(q=>QZ.ans[q.id]!==q.correct):qs;
