      </div>
    </section>
    <aside class="card stack" style="gap:10px;align-self:start"><b style="font-size:14px">خريطة الأسئلة</b><span style="font-size:12.5px;color:var(--muted)">أجبت عن ${toAr(nAns)} من ${toAr(n)}</span>
      <div class="qmap">${QZ.qs.map((x,i)=>{const v=QZ.ans[x.id];let c=v===undefined?"":practice?(v===x.correct?"r":"w"):"ans";return `<button class="${c}${i===QZ.i?" cur":""}" data-i="${i}">${toAr(i+1)}</button>`;}).join("")}</div>
    </aside>
   </div></div>`;
  V.querySelectorAll(".opt:not([disabled])").forEach(b=>b.onclick=()=>{QZ.ans[q.id]=+b.dataset.oi;quizRun();});
  V.querySelectorAll(".qmap button").forEach(b=>b.onclick=()=>{QZ.i=+b.dataset.i;quizRun();});
  $("#qPrev").onclick=()=>{QZ.i--;quizRun();};
