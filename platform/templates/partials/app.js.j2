(function(){
"use strict";
{% if "S2-3" in step2 %}const BOOK={{ book|app_config }};
{% endif %}const {BOOK_METADATA:META, DEEP_STUDY_DATA:CH, QURANIC_EXAMPLES:EX, FLASHCARDS:FC, COMPARISON_TABLES:TB, MIND_MAPS:MM, QUIZ_BANK:QB, CAPSULES:CAPS} = D;

/* ---------- storage ---------- */
{% if "S2-3" in step2 %}const KEY=BOOK.storage_key;{% else %}const KEY="{{ book.storage_key }}";{% endif %}
let S={done:{},mastered:{},again:{},last:null,quizHist:[],lastWrong:[],theme:null,scale:1};
try{const raw=localStorage.getItem(KEY);if(raw)S=Object.assign(S,JSON.parse(raw));}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}

/* ---------- helpers ---------- */
const $=s=>document.querySelector(s);
const AD="٠١٢٣٤٥٦٧٨٩";
const toEn=s=>String(s).replace(/[٠-٩]/g,c=>AD.indexOf(c));
const toAr=n=>String(n).replace(/\d/g,d=>AD[d]);
const esc=s=>String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const norm=s=>String(s).replace(/[ً-ٰٟۖ-ۭـ]/g,"").replace(/[أإآٱ]/g,"ا").replace(/ى/g,"ي").replace(/ة/g,"ه");
function rich(s){
  let h=esc(s);
  h=h.replace(/﴿[^﴾]*﴾/g,m=>`<span class="ayah">${m}</span>`);
  h=h.replace(/«([^»]*)»/g,(m)=>`<span class="cite">${m}</span>`);
  h=h.replace(/\[([^\]\[]{2,40}?):\s?([٠-٩][٠-٩\s\-–،,]*)\]/g,(m)=>`<span class="ref">${m}</span>`);
  h=h.replace(/\(?\bص\s?[٠-٩]+(?:\s?[-–]\s?[٠-٩]+)?\)?/g,m=>`<span class="pg">${m.replace(/[()]/g,"")}</span>`);
  return h;
}
// split "١. Label: rest" into number + bold label
function richItem(s){
  let n="",rest=s;
  const mm=s.match(/^\s*([٠-٩]+(?:\s?و\s?[٠-٩]+)?|[أ-ي]\))[.\-)]?\s+/);
  if(mm){n=mm[1];rest=s.slice(mm[0].length);}
  const ci=rest.indexOf(":"), ai=rest.indexOf("﴿");
  let body;
  if(ci>0&&ci<90&&(ai<0||ci<ai)) body=`<span class="lbl">${rich(rest.slice(0,ci+1))}</span>${rich(rest.slice(ci+1))}`;
  else body=rich(rest);
  return {n,body};
}
function list(items){
  const parsed=items.map(richItem);const numbered=parsed.every(p=>p.n);
  return `<ul class="pts${numbered?" num":""}">${parsed.map(p=>`<li>${numbered?`<span class="n">${esc(p.n)}</span>`:""}${p.body}</li>`).join("")}</ul>`;
}
function pagesOf(str){const m=[...toEn(str).matchAll(/ص\s*(\d+)(?:\s*[-–]\s*(\d+))?/g)];return m.map(x=>+x[1]);}
const splitTitle=t=>{const i=t.indexOf(":");return i>0&&i<40?{k:t.slice(0,i),t:t.slice(i+1).trim()}:{k:"",t};};

/* ---------- index the book ---------- */
const TOPICS=[];
CH.forEach((c,ci)=>c.sections.forEach((s,si)=>s.topics.forEach(t=>{
  const p=toEn(t.pages).match(/\d+/g).map(Number);t.from=p[0];t.to=p[p.length-1];t.ch=c;t.sec=s;t.ci=ci;t.si=si;t.idx=TOPICS.length;
  const st=splitTitle(t.title);t.k=st.k;t.short=st.t;
  t.blocks.forEach(b=>{b.exam=/امتحاني/.test(b.label);b.cleanLabel=b.label.replace(/\s*—?\s*\[موضع سؤال امتحاني\]/,"");});
  TOPICS.push(t);
})));
const topicByPage=p=>TOPICS.find(t=>p>=t.from&&p<=t.to);
const byId=Object.fromEntries(TOPICS.map(t=>[t.id,t]));
{% if features.item_topics %}function attach(arr,field){arr.forEach(x=>{if(x.topic&&byId[x.topic])return;const p=pagesOf(x[field])[0];const t=p&&topicByPage(p);x.topic=t?t.id:null;});}{% else %}function attach(arr,field){arr.forEach(x=>{const p=pagesOf(x[field])[0];const t=p&&topicByPage(p);x.topic=t?t.id:null;});}{% endif %}
attach(FC,"a");attach(QB,"exp");attach(EX,"detail");
TOPICS.forEach(t=>{t.fc=FC.filter(x=>x.topic===t.id);t.qs=QB.filter(x=>x.topic===t.id);t.ex=EX.filter(x=>x.topic===t.id);t.hasExam=t.blocks.some(b=>b.exam)||t.fc.length>0;});

/* ---------- nav ---------- */
const ICONS={
  home:'<path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  study:'<path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5zM12 6v13"/>',
  review:'<rect x="4" y="5" width="13" height="15" rx="2"/><path d="M8 3h10a2 2 0 0 1 2 2v12M8 10h5M8 14h5"/>',
  maps:'<circle cx="12" cy="12" r="2.5"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="m6.5 6.5 3.7 3.7M17.5 6.5l-3.7 3.7M6.5 17.5l3.7-3.7M17.5 17.5l-3.7-3.7"/>',
  quiz:'<path d="M9 11l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/>',
  table:'<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M3.5 10h17M12 10v9"/>',
  ayah:'<path d="M12 3l2.5 4.5L19 6l-1.5 4.5L22 12l-4.5 1.5L19 18l-4.5-1.5L12 21l-2.5-4.5L5 18l1.5-4.5L2 12l4.5-1.5L5 6l4.5 1.5z"/>',
  star:'<path d="M12 4l2.4 5 5.6.6-4.2 3.8 1.2 5.6L12 16.2 7 19l1.2-5.6L4 9.6 9.6 9z"/>',
  info:'<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>'
};
const NAV=[["home","الرئيسية"],["study","الدراسة"],["review","المراجعة"],["maps","الخرائط"],["quiz","الاختبار"]];
function renderNav(cur){
  $("#tnav").innerHTML=NAV.map(([k,l])=>`<a href="#${navHref(k)}"${k===cur?' aria-current="page"':""}>${l}</a>`).join("");
  $("#bnav").innerHTML=NAV.map(([k,l])=>`<a href="#${navHref(k)}"${k===cur?' aria-current="page"':""}><svg viewBox="0 0 24 24">${ICONS[k]}</svg>${l}</a>`).join("");
}
function navHref(k){if(k==="study")return "study-"+(S.last||TOPICS[0].id);if(k==="review")return "review-"+(S.reviewTab||"cards");if(k==="maps")return "maps-"+(S.mapIdx||0);return k;}

/* ---------- sidebar ---------- */
function renderSide(curTopic){
  const done=TOPICS.filter(t=>S.done[t.id]).length,pct=Math.round(done/TOPICS.length*100);
  $("#sideBody").innerHTML=`
  <div class="prog"><div class="ring" style="--p:${pct}"><span>${toAr(pct)}٪</span></div>
   <div><b>${toAr(done)} من ${toAr(TOPICS.length)} مطلباً</b><small>علّم المطلب «تمت دراسته» في آخر الصفحة ليُحسب هنا.</small></div></div>
  <nav class="toc">${CH.map(c=>`<div class="toc-ch"><div class="toc-cht">${esc(c.title.split(":")[0])}</div><div class="toc-chs">${esc(c.title.split(":").slice(1).join(":").trim())} · ${esc(c.badge.replace(/.*\(|\)/g,""))}</div>
   ${c.sections.map(s=>`<div class="toc-sec">${esc(s.title)}</div>${s.topics.map(t=>`<a href="#study-${t.id}" class="${S.done[t.id]?"done":""}"${t.id===curTopic?' aria-current="true"':""}><span class="chk"></span><span>${esc(t.short)}<small>${esc(t.k)} · ${esc(t.pages)}</small></span></a>`).join("")}`).join("")}
  </div>`).join("")}</nav>`;
}
function openSide(){$("#side").classList.add("open");$("#scrim").hidden=false;}
function closeSide(){$("#side").classList.remove("open");$("#scrim").hidden=true;}
$("#tocBtn").onclick=openSide;$("#sideClose").onclick=closeSide;$("#scrim").onclick=closeSide;

/* ---------- views ---------- */
const V=$("#view");
function bestScore(){return S.quizHist.length?Math.max(...S.quizHist.map(h=>Math.round(h.c/h.n*100))):null;}

function ring(p,size,label,col){return `<div class="kring" style="--p:${p};--s:${size}px;--c:${col||"var(--accent)"}"><span>${label}</span></div>`;}
function viewHome(){
  const done=TOPICS.filter(t=>S.done[t.id]).length;
  const mastered=FC.filter(c=>S.mastered[c.id]).length;
  const best=bestScore();
  const last=S.quizHist[S.quizHist.length-1];
  const overall=Math.round((done/TOPICS.length*0.5+mastered/FC.length*0.25+(best||0)/100*0.25)*100);
  const next=S.last?byId[S.last]:TOPICS.find(t=>!S.done[t.id])||TOPICS[0];
  const weak=[...new Set(S.lastWrong.map(id=>QB.find(q=>q.id===id)).filter(q=>q&&q.topic).map(q=>q.topic))].map(id=>byId[id]);
  const fcCats=[...new Set(FC.map(c=>c.cat))].map(cat=>{const l=FC.filter(c=>c.cat===cat);return {cat,n:l.length,m:l.filter(c=>S.mastered[c.id]).length};});
  const hour=new Date().getHours();
  const greet=hour<12?"صباح الخير":hour<18?"مساء النور":"مساء الخير"+(S.name?"، "+esc(S.name):"");
