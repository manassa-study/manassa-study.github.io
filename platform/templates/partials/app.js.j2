      <h3 class="h2" style="font-size:18px">${esc(c.title.split(":").slice(1).join(":").trim())}</h3><p class="lead" style="font-size:13.5px">${esc(c.subtitle)}</p>
      <ol>${ts.map(t=>`<li><a href="#study-${t.id}" class="${S.done[t.id]?"done":""}"><span>${esc(t.short)}</span><span class="pg">${esc(t.pages)}</span></a></li>`).join("")}</ol></article>`;}).join("")}</div></section>
  ${META.upcoming?`<section class="stack"><div class="sec-h"><span class="orn"></span><h2>مباحث قادمة مع الدفعات التالية</h2><span class="orn"></span></div><div class="note"><ol class="objs">${META.upcoming.map(o=>`<li>${esc(o)}</li>`).join("")}</ol></div></section>`:""}
