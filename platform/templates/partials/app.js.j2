     <div class="row">${practice?"":`<span class="timer" id="tmr">${fmt(QZ.deadline-Date.now())}</span>`}<button class="btn" id="qQuit">إنهاء</button></div></div>
   <div class="bar"><i style="width:${nAns/n*100}%"></i></div>
   <div class="qrun">
    <section class="card qcard">
      <div class="row"><span class="tag">${esc(q.type)}</span><span class="tag">${esc(q.chapter)}</span></div>
