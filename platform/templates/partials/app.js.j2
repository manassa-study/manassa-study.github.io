      <div class="opts">${q.options.map((o,oi)=>{let c="";if(practice&&answered){if(oi===q.correct)c="right";else if(oi===a)c="wrong";}else if(oi===a)c="sel";
        return `<button class="opt ${c}" data-oi="${oi}" ${practice&&answered?"disabled":""}><span class="l">${"أبجد"[oi]}</span><span>${rich(o)}</span></button>`;}).join("")}</div>
      ${practice&&answered?`<div class="exp ${a===q.correct?"ok":"no"}"><b>${a===q.correct?"إجابة صحيحة. ":"الإجابة الصحيحة: "+"أبجد"[q.correct]+". "}</b>${rich(q.exp)}${q.topic?` <a href="#study-${q.topic}" style="color:var(--accent);font-family:var(--f-ui);font-size:13px;font-weight:600">راجع المطلب</a>`:""}</div>`:""}
