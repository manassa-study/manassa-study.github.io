  V.innerHTML=`<div class="stack-lg"><header class="phead"><div class="eyebrow">تقرير النتيجة</div><h1 class="h1">${pct>=80?"أداء ممتاز":pct>=50?"أداء جيد، وبقيت مواضع للمراجعة":"تحتاج إلى مراجعة المطالب قبل الإعادة"}</h1></header>
   <section class="card score"><div class="bigring" style="--p:${pct};--c:${col}"><span>${toAr(pct)}٪</span></div>
     <div class="stack" style="gap:8px;flex:1;min-width:200px"><b style="font-size:16px">${toAr(c)} إجابة صحيحة من ${toAr(qs.length)}</b>
     ${chs.map(x=>`<div><div class="row" style="justify-content:space-between;font-size:13.5px"><span>${x.ch}</span><span>${toAr(x.c)}/${toAr(x.n)}</span></div><div class="bar"><i style="width:${x.c/x.n*100}%"></i></div></div>`).join("")}
     <div class="row" style="margin-top:6px">${qs.length-c?`<button class="btn primary" id="qRetryW">أعد الأسئلة الخاطئة (${toAr(qs.length-c)})</button>`:""}<button class="btn" id="qNew">اختبار جديد</button></div></div></section>
   <section class="stack"><div class="row" style="justify-content:space-between"><h2 class="h2">مراجعة الإجابات</h2><div class="row"><button class="chip" id="rvAll" aria-pressed="${!QZ.reviewWrong}">الكل</button><button class="chip" id="rvW" aria-pressed="${!!QZ.reviewWrong}">الخاطئة فقط</button></div></div>
    ${list.map(q=>{const a=QZ.ans[q.id],ok=a===q.correct;return `<article class="rv ${ok?"":"w"}"><div class="row"><span class="tag ${ok?"acc":"exam"}">${ok?"صحيحة":"خاطئة"}</span><span class="tag">${esc(q.chapter)}</span></div>
      <div class="qtext">${rich(q.q)}</div><dl>${ok?"":`<dt>إجابتك</dt><dd>${a===undefined?"لم تُجب":rich(q.options[a])}</dd>`}<dt>الصحيحة</dt><dd>${rich(q.options[q.correct])}</dd></dl>
      <div class="exp">${rich(q.exp)}${q.topic?` <a href="#study-${q.topic}" style="color:var(--accent);font-family:var(--f-ui);font-size:13px;font-weight:600">راجع المطلب</a>`:""}</div></article>`;}).join("")||`<div class="card">لا توجد إجابات خاطئة.</div>`}
   </section></div>`;
  const rw=$("#qRetryW");if(rw)rw.onclick=()=>{QZ.qs=qs.filter(q=>QZ.ans[q.id]!==q.correct);QZ.ans={};QZ.i=0;QZ.phase="run";QZ.deadline=Date.now()+QZ.qs.length*90000;viewQuiz();scrollTo(0,0);};
  $("#qNew").onclick=()=>{QZ.phase="setup";QZ.wrongOnly=false;QZ.bank=false;viewQuiz();scrollTo(0,0);};
  $("#rvAll").onclick=()=>{QZ.reviewWrong=false;quizDone();};$("#rvW").onclick=()=>{QZ.reviewWrong=true;quizDone();};
}

