/* ---------- welcome popup (once per visit) ---------- */
function showWelcome(force){
  let seen=false;try{seen={% if "S2-3" in step2 %}sessionStorage.getItem(BOOK.welcome_session_key){% else %}sessionStorage.getItem("{{ book.welcome_session_key }}"){% endif %}==="1";}catch(e){}
  if(seen&&!force)return;
  const w=$("#wel");w.hidden=false;document.body.style.overflow="hidden";
  $("#welIntro").hidden=!!force;$("#welPick").hidden=!force;
  const close=()=>{w.hidden=true;document.body.style.overflow="";{% if "S2-3" in step2 %}try{sessionStorage.setItem(BOOK.welcome_session_key,"1");}catch(e){}{% else %}try{sessionStorage.setItem("{{ book.welcome_session_key }}","1");}catch(e){}{% endif %}};
  const pick=()=>{$("#welIntro").hidden=true;$("#welPick").hidden=false;w.scrollTop=0;setTimeout(()=>w.querySelector(".pick").focus(),30);};
  $("#welGo").onclick=pick;$("#welDash").onclick=close;w.onclick=e=>{if(e.target===w)close();};
  w.querySelectorAll(".pick").forEach(p=>p.onclick=()=>{
    close();const go=p.dataset.go;
    if(go==="exam"){QZ.phase="setup";QZ.mode="exam";QZ.ch="الكل";QZ.type="الكل";QZ.wrongOnly=false;location.hash==="#quiz"?route():location.hash="quiz";}
    else if(go==="revision"){location.hash="review-cards";}
    else{const t=S.last?byId[S.last]:TOPICS.find(t=>!S.done[t.id])||TOPICS[0];location.hash="study-"+t.id;}
  });
  setTimeout(()=>(force?w.querySelector(".pick"):$("#welGo")).focus(),50);
}
