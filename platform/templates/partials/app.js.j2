function qSecOf(q){const t=q.topic&&TOPICS.find(x=>x.id===q.topic);return t?t.ci+"-"+t.si:"";}
function qCount(p){return QZ.cnt?Math.min(QZ.cnt,p.length):p.length;}
function quizPool(){return QB.filter(q=>(QZ.ch==="الكل"||q.chapter===QZ.ch)&&(QZ.type==="الكل"||q.type===QZ.type)&&(!QZ.sec||qSecOf(q)===QZ.sec)&&(!QZ.wrongOnly||S.lastWrong.includes(q.id))&&(!QZ.bank||(S.wrongBank||[]).includes(q.id)));}
function fmt(ms){const s=Math.max(0,Math.round(ms/1000));return toAr(String(Math.floor(s/60)).padStart(2,"0"))+":"+toAr(String(s%60).padStart(2,"0"));}
function quizRun(){
