    ["#study-"+next.id,"study","الدراسة المعمّقة",toAr(TOPICS.length)+" مطلباً","t1"],
    ["#review-cards","review","بطاقات الاستذكار",toAr(FC.length)+" بطاقة","t2"],
    ["#review-tables","table","جداول الفروق",toAr(TB.length)+" جدولاً","t3"],
    ["#maps-0","maps","خرائط المراجعة",toAr(MM.length+1)+" خرائط","t4"],
    {% if "S2-3" in step2 %}["#review-ayat","ayah",BOOK.labels.examples_title,toAr(EX.length)+" "+BOOK.labels.examples_count_noun,"t2"],{% else %}["#review-ayat","ayah","{{ book.labels.examples_title }}",toAr(EX.length)+" {{ book.labels.examples_count_noun }}","t2"],{% endif %}
    ["#review-capsules","star","كبسولات الحفظ","أرقام وأعلام ومقولات","t3"],
    ["#quiz","quiz","الاختبار المحاكي",toAr(QB.length)+" سؤالاً","t1"],
    ["#about","info","عن المقرر","المحاور ومصدر المادة","t4"],
  ];
  V.innerHTML=`<div class="dash">
  <section class="dhero">
    <div class="dhero-in">
      <div class="dhero-txt">
        <div class="dhero-by"><span>إعداد وتصميم</span><b>محمد بلال البلوشي</b></div>
        <div class="dhero-greet">${greet} · لوحة المذاكرة</div>
        <h1 class="dhero-title">{{ book.title }}</h1>
        <p class="dhero-sub">كتاب «${esc(META.title)}» · تأليف ${esc(META.authors{% if features.author_first_segment %}.split("،")[0]{% endif %})}</p>
        <div class="row" style="margin-top:6px">
          <a class="btn gold" href="#study-${next.id}">${S.last?"تابع من حيث توقفت":"ابدأ الدراسة"} ←</a>
          <button class="btn glass" id="pickBtn">ماذا أذاكر اليوم؟</button>
        </div>
      </div>
      <div class="dhero-ring">${ring(overall,132,`<b>${toAr(overall)}٪</b><small>جاهزيتك</small>`,"var(--hero-gold)")}</div>
    </div>
  </section>

    <section class="panel resume solo">
      <div class="panel-h"><span class="eyebrow">أكمل من حيث توقفت</span></div>
      <div class="resume-k">${esc(next.ch.title.split(":")[0])} · ${esc(next.k)}</div>
      <h2 class="resume-t">${esc(next.short)}</h2>
      <div class="row"><span class="pg">${esc(next.pages)}</span>${next.blocks.some(b=>b.exam)?'<span class="tag exam">فيه موضع امتحاني</span>':""}${next.qs.length?`<span class="tag gold">${toAr(next.qs.length)} أسئلة</span>`:""}</div>
      <a class="btn primary" href="#study-${next.id}" style="align-self:flex-start">افتح المطلب</a>
    </section>


  <section>
    <div class="sec-h"><span class="orn"></span><h2>أقسام المنصة</h2><span class="orn"></span></div>
    <div class="tiles">${TILES.map(([h,ic,t,s,c])=>`<a class="tile ${c}" href="${h}"><span class="tile-i"><svg viewBox="0 0 24 24">${ICONS[ic]}</svg></span><b>${t}</b><span>${s}</span></a>`).join("")}</div>
  </section>

  <details class="hprog" id="progBox"${S.progOpen?" open":""}><summary><span class="prog-t">تقدّمي</span><span class="prog-s">المطالب ${toAr(done)}/${toAr(TOPICS.length)} · البطاقات ${toAr(mastered)}/${toAr(FC.length)} · أفضل نتيجة ${best===null?"—":toAr(best)+"٪"}</span><span class="prog-o">عرض</span></summary><div class="prog-in">
  <section class="kpis">
    <a class="kpi" href="#study-${next.id}">${ring(Math.round(done/TOPICS.length*100),58,toAr(done))}<div><b>المطالب المدروسة</b><span>${toAr(done)} من ${toAr(TOPICS.length)}</span></div></a>
    <a class="kpi" href="#review-cards">${ring(Math.round(mastered/FC.length*100),58,toAr(mastered),"var(--b3)")}<div><b>البطاقات المتقنة</b><span>${toAr(mastered)} من ${toAr(FC.length)}</span></div></a>
    <a class="kpi" href="#quiz">${ring(best||0,58,best===null?"—":toAr(best)+"٪","var(--b2)")}<div><b>أفضل نتيجة</b><span>${S.quizHist.length?toAr(S.quizHist.length)+" محاولة":"لم تختبر بعد"}</span></div></a>
    <a class="kpi" href="#quiz">${ring(last?Math.round(last.c/last.n*100):0,58,last?toAr(Math.round(last.c/last.n*100))+"٪":"—","var(--b4)")}<div><b>آخر محاولة</b><span>${last?toAr(last.c)+" من "+toAr(last.n):"ابدأ أول اختبار"}</span></div></a>
  </section>

  <div class="dgrid">
    <section class="panel">
      <div class="panel-h"><span class="eyebrow">تقدّمك في الفصول</span></div>
      ${CH.map((c,ci)=>{const ts=TOPICS.filter(t=>t.ch===c),d=ts.filter(t=>S.done[t.id]).length;return `
        <div class="chp">
          <div class="chp-h"><span class="chp-n c${ci+1}">${toAr(ci+1)}</span><div style="min-width:0;flex:1"><b>${esc(c.title.split(":").slice(1).join(":").trim())}</b><small>${esc(c.badge.replace(/.*\(|\)/g,""))}</small></div><span class="chp-c">${toAr(d)}/${toAr(ts.length)}</span></div>
          <div class="segbar">${ts.map(t=>`<a href="#study-${t.id}" class="${S.done[t.id]?"on":""}" title="${esc(t.short)}"></a>`).join("")}</div>
        </div>`;}).join("")}
    </section>
    </div>
  <div class="dgrid">
    <section class="panel">
      <div class="panel-h"><span class="eyebrow">إتقان البطاقات حسب التصنيف</span><a class="btn ghost sm" href="#review-cards">راجع</a></div>
      <div class="hbars">${fcCats.map(x=>`<div class="hb"><span>${esc(x.cat)}</span><div class="bar"><i style="width:${x.m/x.n*100}%;background:var(--b3)"></i></div><em>${toAr(x.m)}/${toAr(x.n)}</em></div>`).join("")}</div>
    </section>
    <section class="panel">
      <div class="panel-h"><span class="eyebrow">${weak.length?"مطالب تحتاج مراجعة":"نتائج الاختبارات"}</span></div>
      ${weak.length?`<p class="muted">من أخطائك في آخر اختبار:</p><div class="weak">${weak.map(t=>`<a href="#study-${t.id}"><span>${esc(t.short)}</span><span class="pg">${esc(t.pages)}</span></a>`).join("")}</div>`
       :S.quizHist.length?`<div class="spark">${S.quizHist.slice(-10).map(h=>{const p=Math.round(h.c/h.n*100);return `<div title="${toAr(p)}٪"><i style="height:${Math.max(p,4)}%"></i><small>${toAr(p)}</small></div>`;}).join("")}</div><p class="muted">آخر ${toAr(Math.min(10,S.quizHist.length))} محاولات. لا أخطاء في آخر اختبار.</p>`
       :`<div class="empty"><b>لم تبدأ أي اختبار بعد</b><p class="muted">بعد أول اختبار ستظهر هنا نتائجك والمطالب التي تحتاج مراجعتها.</p><a class="btn primary" href="#quiz">ابدأ اختباراً قصيراً</a></div>`}
    </section>
  </div>
  </div></details>

  <footer class="credit"><span class="orn"></span><p>تصميم: <b>محمد بلال البلوشي</b></p><span class="orn"></span></footer>
  </div>`;
  const pb=$("#pickBtn");if(pb)pb.onclick=()=>showWelcome(true);const pg=$("#progBox");if(pg)pg.ontoggle=()=>{S.progOpen=pg.open;save();};
}
function viewAbout(){
  V.innerHTML=`<div class="stack-lg">
  <header class="phead"><div class="eyebrow">عن المقرر والمادة</div><h1 class="h1">${esc(META.title)}</h1>
    <p class="lead">${esc(META.authors.replace("&","و"))}</p></header>
  <section class="stack"><div class="sec-h"><span class="orn"></span><h2>محاور المقرر</h2><span class="orn"></span></div>
    <ol class="objs">${META.objectives.map(o=>`<li>${rich(o)}</li>`).join("")}</ol></section>
