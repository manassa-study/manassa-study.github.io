const IDX=[];
TOPICS.forEach(t=>t.blocks.forEach((b,i)=>IDX.push({g:"المطالب",title:t.short+" · "+b.cleanLabel,text:[b.text,b.ayah,...(b.list||[])].filter(Boolean).join(" "),href:"#study-"+t.id,blk:i,tid:t.id})));
FC.forEach(c=>IDX.push({g:"البطاقات",title:c.q,text:c.a,ans:c.a}));
{% if "S2-3" in step2 %}EX.forEach(e=>IDX.push({g:BOOK.labels.examples_title,{% else %}EX.forEach(e=>IDX.push({g:"{{ book.labels.examples_title }}",{% endif %}title:e.ayah+" "+e.surah,text:e.detail,href:"#review-ayat"}));
QB.forEach(q=>IDX.push({g:"الأسئلة",title:q.q,text:q.options.join(" ")+" "+q.exp,ans:"الإجابة: "+q.options[q.correct]+" — "+q.exp}));
IDX.forEach(x=>{x.n=norm(x.title+" "+x.text);});
function snippet(text,qn){
  const nt=norm(text);const i=nt.indexOf(qn);if(i<0)return esc(text.slice(0,140))+"…";
  // map normalized index back approximately by stripping diacritics in a parallel walk
  let raw=0,k=0;const strip=/[ً-ٰٟۖ-ۭـ]/;
  while(k<i&&raw<text.length){if(!strip.test(text[raw]))k++;raw++;}
  let end=raw,k2=0;while(k2<qn.length&&end<text.length){if(!strip.test(text[end]))k2++;end++;}
  const s=Math.max(0,raw-60),e=Math.min(text.length,end+80);
  return (s?"…":"")+esc(text.slice(s,raw))+"<mark>"+esc(text.slice(raw,end))+"</mark>"+esc(text.slice(end,e))+(e<text.length?"…":"");
}
function doSearch(){
  const q=$("#q").value.trim(),R=$("#spRes");
  if(q.length<2){R.innerHTML=`<div class="sr-g">جرّب</div><div class="sugg">{% if "S2-3" in step2 %}${BOOK.search.suggestions.map({% else %}{{ "${" }}{{ book.search.suggestions|js_array }}.map({% endif %}w=>`<button class="chip" data-w="${w}">${w}</button>`).join("")}</div>`;
    R.querySelectorAll("[data-w]").forEach(b=>b.onclick=()=>{$("#q").value=b.dataset.w;doSearch();});return;}
  const qn=norm(q);const hits=IDX.filter(x=>x.n.includes(qn));
  if(!hits.length){R.innerHTML=`<div class="card">لا نتائج لـ «${esc(q)}». جرّب كلمة أقصر أو بدون تشكيل.</div>`;return;}
  const groups=[...new Set(hits.map(h=>h.g))];
  R.innerHTML=`<div class="sr-g">${toAr(hits.length)} نتيجة</div>`+groups.map(g=>`<div class="sr-g">${g}</div>`+hits.filter(h=>h.g===g).slice(0,25).map((h)=>{const id=IDX.indexOf(h);
    return h.href?`<a class="sr-i" href="${h.href}" data-id="${id}"><b>${rich(h.title)}</b><span>${snippet(h.text,qn)}</span></a>`
      :`<button class="sr-i" data-id="${id}"><b>${rich(h.title)}</b><span>${norm(h.title).includes(qn)?"اضغط لعرض الجواب":snippet(h.text,qn)}</span><span class="ans">${rich(h.ans)}</span></button>`;}).join("")).join("");
  R.querySelectorAll("a.sr-i").forEach(a=>a.onclick=()=>{const h=IDX[+a.dataset.id];pendingBlock=h.blk;closeSearch();if(location.hash===h.href){route();}});
  R.querySelectorAll("button.sr-i").forEach(b=>b.onclick=()=>b.classList.toggle("open"));
}
let pendingBlock=null;
function openSearch(){$("#sp").hidden=false;document.body.style.overflow="hidden";doSearch();setTimeout(()=>$("#q").focus(),30);}
function closeSearch(){$("#sp").hidden=true;document.body.style.overflow="";}
$("#searchBtn").onclick=openSearch;$("#spClose").onclick=closeSearch;$("#q").oninput=doSearch;
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeSearch();closeSide();if(!$("#wel").hidden)$("#welDash").click();}if(e.key==="/"&&document.activeElement.tagName!=="INPUT"){e.preventDefault();openSearch();}});

