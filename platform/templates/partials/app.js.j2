})();

/* ---------- router ---------- */
function route(){
  const h=(location.hash||"#home").slice(1);const [k,...rest]=h.split("-");const arg=rest.join("-");
  let cur=k,topicId=null;
  closeSide();
  if(k==="study")topicId=viewStudy(arg);
  else if(k==="review")viewReview(arg);
  else if(k==="maps")viewMaps(arg);
