details.blk:not([open])>summary::after{content:"عرض";flex:none;align-self:center;font-family:var(--f-ui);font-size:12.5px;font-weight:700;color:var(--accent);padding:3px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--accent) 35%,transparent)}
.tsum>summary span,.selftest>summary em,.hprog .prog-o,.mm2-dd>summary em{font-style:normal;font-size:13px!important;font-weight:700;color:var(--accent)!important;padding:4px 14px;border-radius:999px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);white-space:nowrap}
