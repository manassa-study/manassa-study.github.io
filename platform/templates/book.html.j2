function blockHTML(b,i){
  let h=`<details class="blk${b.exam?" exam":""}" id="b${i}"${i===0?" open":""}><summary><h3>${rich(b.cleanLabel)}${b.exam?` <span class="tag exam">موضع سؤال امتحاني</span>`:""}</h3></summary><div class="blk-b">`;
  if(b.text)h+=`<p>${rich(b.text)}</p>`;
  if(b.ayah){const m=b.ayah.match(/^(﴿[^﴾]*﴾)\s*(.*)$/);h+=`<div class="ayah-box"><span class="ayah">${esc(m?m[1]:b.ayah)}</span>${m&&m[2]?`<span class="ref">${esc(m[2])}</span>`:""}</div>`;}
  if(b.list)h+=list(b.list);
  return h+`</div></details>`;
}
function questionBlock(q,i,prefix){
  return `<div class="qcard" data-q="${q.id}" data-prefix="${prefix}">
    <div class="row"><span class="tag">${esc(q.type)}</span></div>
    <div class="qtext">${rich(q.q)}</div>
    <div class="opts">${q.options.map((o,oi)=>`<button class="opt" data-oi="${oi}"><span class="l">${"أبجد"[oi]}</span><span>${rich(o)}</span></button>`).join("")}</div>
    <div class="fb"></div></div>`;
}
function wirePractice(root){
  root.querySelectorAll(".qcard").forEach(card=>{
    const q=QB.find(x=>x.id==card.dataset.q);
    card.querySelectorAll(".opt").forEach(btn=>btn.onclick=()=>{
      const oi=+btn.dataset.oi,ok=oi===q.correct;
      card.querySelectorAll(".opt").forEach((b,bi)=>{b.disabled=true;if(bi===q.correct)b.classList.add("right");});
      if(!ok)btn.classList.add("wrong");
      card.querySelector(".fb").innerHTML=`<div class="exp ${ok?"ok":"no"}"><b>${ok?"إجابة صحيحة. ":"الإجابة الصحيحة: "+"أبجد"[q.correct]+". "}</b>${rich(q.exp)}</div>`;
    });
  });
}

